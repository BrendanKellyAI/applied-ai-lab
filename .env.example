# Copy this file to .env and add the keys for the providers you want to use.
# You only need one key to reproduce part of an experiment.
# Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required when the Anthropic key is not scoped to a single workspace (Console → Settings →
# Workspaces). Keys created for one workspace can omit this.
ANTHROPIC_WORKSPACE_ID=
# The Google SDK also accepts GEMINI_API_KEY. If both are set, GOOGLE_API_KEY is used.
GOOGLE_API_KEY=
